# Base URL baked into certificate QR codes / verification captions.
# Server-only (private) — do NOT prefix with NEXT_PUBLIC_. Must be the site ROOT
# WITHOUT a trailing /verify (the app appends /verify/<token> itself). A value
# ending in /verify produces broken /verify/verify/... links.
VERIFY_BASE_URL=https://www.darbartech.com
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Development-only fallback admin accounts (see src/lib/services/authService.ts).
# In production, real admin accounts live in the `admin_users` table seeded by
# `npm run bootstrap:admin`; these env passwords are ignored there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
STAFF_PASSWORD=change_me_to_a_different_strong_password
# Required in production. Must be 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=your_random_64_char_secret
CERTIFICATE_PREFIX=DT-CERT
# V2 §19: only trust X-Forwarded-For / X-Real-IP when the app is actually behind
# a trusted reverse proxy. Leave unset/false for direct connections.
TRUSTED_PROXY_MODE=false
# V2 §16: admin session lifetime in minutes (default 480 = 8h).
ADMIN_SESSION_TTL_MINUTES=480
# V2 §11/§12: shared secret for scheduled maintenance endpoints
# (audit outbox drain + stale issuance recovery).
ISSUANCE_RECOVERY_SECRET=your_random_cron_secret
# V2 §15: one-time production bootstrap (used by `npm run bootstrap:admin` only).
ADMIN_BOOTSTRAP_USERNAME=owner@darbartech.example
ADMIN_BOOTSTRAP_PASSWORD=change_me_to_a_strong_password
ADMIN_BOOTSTRAP_ROLE=super_admin
# ADMIN_BOOTSTRAP_RESET=true
